prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: jarvislib
Description: Multilingual Voice Assistant Ontology, Adaptive VAD, Wake-Word Matching, Streaming TTS, and Desktop Automation
Version: 1.0.0
Libs: -L${libdir} -ljarvis -lm
Cflags: -I${includedir}/ttypt
