#!/usr/bin/env python3
import sys
import os
import asyncio
import subprocess
import struct

try:
    import edge_tts
except ImportError:
    candidates = [
        os.path.expanduser("~/.local/share/dwm-voice/venv/bin/python"),
        os.path.expanduser("~/.venv/bin/python"),
    ]
    for venv_py in candidates:
        if os.path.exists(venv_py) and sys.executable != venv_py:
            os.execv(venv_py, [venv_py] + sys.argv)
    sys.stderr.write("edge-tts not found. Install via: pip install edge-tts\n")
    sys.exit(1)

async def synth_pcm_bytes(text, voice):
    comm = edge_tts.Communicate(text, voice)
    mp3 = bytearray()
    async for chunk in comm.stream():
        if chunk.get("type") == "audio":
            data = chunk.get("data")
            if data:
                mp3.extend(data)
    if not mp3:
        return b""
    cmd = ["ffmpeg", "-loglevel", "error", "-i", "pipe:0", "-f", "s16le", "-ar", "24000", "-ac", "1", "pipe:1"]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    out, _ = proc.communicate(input=bytes(mp3))
    if proc.returncode != 0:
        sys.stderr.write(f"edge-tts-pcm: ffmpeg failed rc={proc.returncode}\n")
        sys.stderr.flush()
        return b""
    return out or b""

def serve_loop():
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    out_buf = sys.stdout.buffer
    try:
        while True:
            line = sys.stdin.readline()
            if not line:
                break
            line = line.rstrip("\r\n")
            if not line:
                continue
            if line == "QUIT" or line.startswith("QUIT\t"):
                break
            if "\t" in line:
                voice, text = line.split("\t", 1)
            else:
                voice, text = "pt-PT-RaquelNeural", line
            voice = voice.strip() or "pt-PT-RaquelNeural"
            text = text.strip()
            pcm = b""
            if text:
                try:
                    pcm = loop.run_until_complete(synth_pcm_bytes(text, voice))
                except Exception as exc:
                    sys.stderr.write(f"edge-tts-pcm: synthesis error ({voice}): {exc}\n")
                    sys.stderr.flush()
                    pcm = b""
            out_buf.write(struct.pack("<I", len(pcm)))
            if pcm:
                out_buf.write(pcm)
            out_buf.flush()
    finally:
        loop.close()

def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "--serve":
        serve_loop()
        return
    if len(sys.argv) < 2:
        sys.exit(1)
    text = sys.argv[1]
    voice = sys.argv[2] if len(sys.argv) > 2 else "pt-PT-RaquelNeural"
    pcm = asyncio.run(synth_pcm_bytes(text, voice))
    if pcm:
        os.write(sys.stdout.fileno(), pcm)

if __name__ == "__main__":
    main()
